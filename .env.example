# Server
PORT=3000
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rate_limiter
DB_USER=postgres
DB_PASSWORD=yourpassword

# Kafka (optional — rate limit events are published here)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=rate-limit-events
KAFKA_CLIENT_ID=rate-limiter-service
KAFKA_ENABLED=false
